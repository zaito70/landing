# Copia este archivo como .env y cambia los valores.
PORT=3010
# Contraseña para entrar al panel del CRM (usa una larga).
CRM_TOKEN=cambia-esta-contraseña
# URL del nodo Webhook de tu flujo de n8n (déjalo vacío si aún no usas n8n).
N8N_WEBHOOK_URL=
# Dominios que pueden enviar registros (tu landing). * = cualquiera.
ALLOWED_ORIGINS=*
DB_PATH=crm.sqlite
